<!DOCTYPE html>
<html lang="da">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <title>AMAbot</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="text-scale" content="scale" />
    <meta name="description" content="Min personlige AMAbot" />
    <meta name="author" content="Stine Blaabjerg Lock" />
    <link rel="stylesheet" type="text/css" media="screen" href="/main.css" />
    <script src="/index.js" defer></script>
  </head>
  <body>
    <header>
      <h1 class="text-light">AMAbot</h1>
    </header>
    <main>
      <section class="welcome-section">
        <h1>Hello world</h1>
      </section>
      <section class="chat-section">
        <article class="chat-grid">
          <article class="question"><p>Spørgsmål</p></article>
          <article class="answer"><p>Svar</p></article>
        </article>
        <article class="chat-grid">
          <article class="question"><p>Spørgsmål</p></article>
          <article class="answer"><p>Svar</p></article>
        </article>
      </section>
      <section class="form-section">
        <form>
          <label for="question" aria-label="Enter your question here"
            >Stil dit spørgsmål her:</label
          >
          <div class="flex-column">
            <input
              type="textarea"
              name="question"
              placeholder="Hvad vil du gerne vide?"
            />
            <button><span>-></span></button>
          </div>
        </form>
      </section>
    </main>
  </body>
</html>
