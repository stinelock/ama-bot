<!DOCTYPE html>
<html lang="da">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <title>AMAbot</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="text-scale" content="scale" />
    <meta name="description" content="Min personlige AMAbot" />
    <meta name="author" content="Stine Blaabjerg Lock" />
    <link rel="stylesheet" type="text/css" media="screen" href="/main.css" />
    <link rel="stylesheet" href="https://use.typekit.net/dub7zvl.css" />
  </head>
  <body>
    <header>
      <h1 class="text-light">AMAbot</h1>
    </header>
    <main>
      <div class="main-grid">
        <img src="/images/portrait-2.svg" id="portrait" alt="Portrait of Stine Blaabjerg Lock"/>
        <section class="main-section">
          <% if (!messages || messages.length === 0) { %>
          <section>
            <h1>Spørg mig om alt</h1>
            <p>
              Her kan du lære mere om mig. Bare stil et spørgsmål og så svarer
              jeg så godt jeg kan!
            </p>
          </section>
          <% } %>

          <% if (messages && messages.length > 0) { %>
          <section class="chat-section">
            <% for (const message of messages) { %>
            <article class="chat-box">
              <article class="<%= message.type %>">
                <p><%= message.text %></p>
              </article>
              <p class="timestamp"><%= message.createdAt %></p>
            </article>
            <% } %>
          </section>
          <% } %>
          <section class="form-section">
            <form method="POST" action="/ask">
              <label for="question" aria-label="Enter your question here"
                >Stil dit spørgsmål her:</label
              >
              <div class="flex-row">
                <input
                  type="text"
                  name="question"
                  id="question"
                  placeholder="Hvad vil du gerne vide?"
                />
                <button type="submit">
                  <img src="/images/send-btn.svg" />
                </button>
              </div>
            </form>
            <% if (error) { %>
            <p role="alert"><%= error %></p>
            <% } %>
          </section>
        </section>
        <section class="stats-section">
          <h2>Statistik</h2>
          <p>Antal spørgsmål stillet:</p>
          <ul>
            <% for (const [key, value] of Object.entries(topicStats)) { %>
            <li><%= key %>: <%= value %></li>
            <% } %>
          </ul>
           <form method="POST" action="/reset">
          <button type="submit">Reset chat</button>
        </form>
        </section>
      </div>
    </main>
  </body>
</html>
